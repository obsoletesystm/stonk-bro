# Database Configuration
POSTGRES_USER=stockuser
POSTGRES_DB=stockdb
DB_PASSWORD=change_this_to_secure_password

# Database URL for application (update password to match DB_PASSWORD)
DATABASE_URL=postgresql://stockuser:change_this_to_secure_password@postgres:5432/stockdb

# Redis
REDIS_URL=redis://redis:6379

# API Keys (get from providers)
# Get from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Get from: https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# Application Config
ENVIRONMENT=production
LOG_LEVEL=info

# Monitoring (optional - only needed if using monitoring profile)
GRAFANA_PASSWORD=admin

# TFSA Settings (update with your information)
TFSA_BIRTH_YEAR=1990
TFSA_INITIAL_CONTRIBUTION_ROOM=95000

# Discord Webhook (for alerts)
# Get from Discord: Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
