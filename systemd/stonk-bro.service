[Unit]
Description=Stonk Bro Stock Research Platform
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/willmcnaughton/Documents/code/stonk-bro
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
User=willmcnaughton
Group=willmcnaughton

# Restart policy
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
